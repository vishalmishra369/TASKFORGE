schema_version = "1.3"

[task]
name = "{{ namespace }}/{{ task_id }}"

[metadata]
repo = "{{ repo_url }}"
base_commit = "{{ base_commit }}"
release_tag = "{{ tag }}"
license = "BSD-3-Clause"
archetype = "{{ archetype }}"
generator = "taskforge {{ version }}"
category = "feature-development"

[verifier]
timeout_sec = 600.0

[agent]
timeout_sec = 1800.0

[environment]
cpus = 2
memory_mb = 4096
